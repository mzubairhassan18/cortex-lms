{
  // Cloudflare Workers Static Assets — static site plus the API, one deploy.
  //
  // Cloudflare's own guidance: "If you are starting a new project, use Workers
  // instead of Pages." Pages still works, but it now delegates to Workers and
  // the delegation failed on first contact here (`wrangler pages project
  // create` -> "Missing entry-point to Worker script or to assets directory").
  //
  // Routing (documented behavior):
  //   - a URL matching a file in `directory` is served WITHOUT running the Worker
  //   - `run_worker_first` sends /api/* to the Worker before the asset lookup,
  //     so the API is never shadowed by a file of a similar name
  //   - everything else that misses falls through to the Worker, which answers
  //     it with `env.ASSETS.fetch(request)`
  //
  // `binding` is only valid because there is now a `main`.
  //
  // Build before deploying — Cloudflare uploads what is on disk, it does not
  // build. The base must match this host, which serves at the root:
  //
  //   node scripts/assemble.mjs --base /     <- root (*.workers.dev)
  //   node scripts/assemble.mjs              <- /cortex-lms/, GitHub Pages
  //   wrangler deploy
  //
  "name": "cortex",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // File originals (P2 storage). The extracted TEXT goes in Postgres on the
  // `files` row — API reads are unmetered and the text is what the prompt
  // actually needs — while the original bytes come here, so a 5 MB PDF costs
  // R2 storage instead of a database row. Same account as the Worker: one
  // deploy, one runtime, no second secret surface, and the bucket is reached
  // by binding rather than over the network, so there is no CORS to configure
  // and no public URL for somebody to guess.
  "r2_buckets": [
    {
      "bucket_name": "cortex-files",
      "binding": "BUCKET"
    }
  ],
  "vars": {
    // Both values are already published in public/js/auth.js — the key is the
    // *publishable* one, not the service role. Passing it alongside the
    // caller's own Authorization header is what keeps RLS in force: PostgREST
    // then sees the `authenticated` role and auth.uid() resolves, so every
    // query is scoped to the signed-in user by policy rather than by code.
    "SUPABASE_URL": "https://agyxcfnfvggpbhzyhrsj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_woXb6y4EzUGKIcrn_rgm1Q_sf53LpBy"
  }
}
